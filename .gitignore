# --- Foundry ---
# Build artifacts
cache/
out/

# Broadcast logs: keep the real deploy records, drop local/dry-run noise
!/broadcast
/broadcast/*/31337/
/broadcast/**/dry-run/

# --- Secrets ---
# Never commit real secrets. Commit only *.example templates.
.env
.env.*
!.env.example
!.env.deploy.example
.env.deploy

# --- Node ---
node_modules/
app/node_modules/
app/dist/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
*.tsbuildinfo

# --- Cloudflare Workers local state ---
.wrangler/
backend/.wrangler/

# --- Editor / OS ---
.DS_Store
Thumbs.db
desktop.ini
:*:Zone.Identifier
.vscode/*
!.vscode/extensions.json
!.vscode/settings.json
.idea/

# 백엔드 알림 로직 단위 테스트가 워커에서 떼어낸 임시 파일
backend/src/.alerts-extract.mjs
