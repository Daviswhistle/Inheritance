# --- Foundry ---
# Build artifacts
cache/
out/

# Broadcast logs: keep the real deploy records, drop local/dry-run noise
!/broadcast
/broadcast/*/31337/
/broadcast/**/dry-run/

# --- Secrets ---
# Never commit real secrets. Commit only *.example templates.
.env
.env.*
!.env.example

# --- Node ---
node_modules/
app/node_modules/
app/dist/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
*.tsbuildinfo

# --- Cloudflare Workers local state ---
.wrangler/
backend/.wrangler/

# --- Editor / OS ---
.DS_Store
Thumbs.db
desktop.ini
:*:Zone.Identifier
.vscode/*
!.vscode/extensions.json
!.vscode/settings.json
.idea/
