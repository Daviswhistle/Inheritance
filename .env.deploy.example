# 배포용 환경변수 — 이 파일은 절대 커밋하지 마세요 (.gitignore 에 포함됨)
#
# 사용법
#   1) cp .env.deploy.example .env.deploy
#   2) PRIVATE_KEY 를 채움  (World Chain 가스비만 낼 수 있는 전용 지갑 권장)
#   3) set -a && . ./.env.deploy && set +a
#   4) WLD_ADDRESS=<WLD 주소> forge script script/DeployWLDFactory.s.sol:DeployWLDFactory \
#        --rpc-url <RPC> --broadcast
#
# 주의
#   - 앱( custodial 아님)과 무관하게, 배포 키는 "컨트랙트 생성만 하는" 용도로
#     별도 지갑을 쓰는 것이 안전합니다. 그 지갑에 자금을 오래 두지 마세요.
#   - PRIVATE_KEY 를 채팅에 붙여넣지 마세요. 셸 히스토리에 남습니다.

# World Chain 메인넷 배포자 개인 키
PRIVATE_KEY=

# WLD 토큰 주소 (World Chain 메인넷)
WLD_ADDRESS=0x2cfc85d8e48f8eab294be644d9e25c3030863003

# 체인 ID 확인용 값 — World Chain mainnet 은 480
CHAIN_ID=480
