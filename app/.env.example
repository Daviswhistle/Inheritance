# ---- World App -------------------------------------------------------------
# Mini App ID. index.html 의 <meta name="minikit:app-id"> 와 동일해야 한다.
VITE_WORLD_APP_ID=app_28c40a2a42b7f6c95789c2d5231b1314
# World Cloud 에 등록한 action id (Verify 호출 시 사용)
VITE_WORLD_ACTION_ID=inheritance_access

# ---- Contracts -------------------------------------------------------------
# WLD 상속 금고 팩토리 주소 (World Chain mainnet)
# 배포: node scripts/deploy-factory.mjs (온체인 bytecode 일치 검증 포함)
# 2단계 상속 + 7일 후 고정 상속인에게 permissionless 자동 실행.
# World Chain 블록 35771900 에 배포됨. 이 값은 저장소 변수와 반드시 같아야 한다 —
# 배포는 app/.env 가 아니라 저장소 변수를 읽는다.
# 팩토리를 교체하면 이 파일 / app/.env / 저장소 변수 / scripts/portal-allowlist.py
# 넷을 같이 갱신한다. 하나만 빼먹으면 옛 주소가 "누락" 으로 잘못 보고되거나,
# 이벤트 조회 fromBlock 이 틀려서 금고 목록이 조용히 비어 보인다.
VITE_FACTORY_ADDRESS=0xb74342FC15C504108cFD91366493590A9d570D26
VITE_FACTORY_DEPLOY_BLOCK=35771900
# 기존 금고의 조회·거래·수동 수령을 계속 지원한다.
VITE_LEGACY_FACTORY_ADDRESS=0xF7BeEDDeB8bE1DbC4Bd8768fC3f1e513DD6C1d88
VITE_LEGACY_FACTORY_DEPLOY_BLOCK=35672936
# WLD 토큰 주소 (World Chain mainnet)
VITE_WLD_ADDRESS=0x2cfc85d8e48f8eab294be644d9e25c3030863003
# 팩토리 배포 블록. 로그 조회의 fromBlock 으로 쓰이므로 정확해야 한다.
# DEPLOYMENTS.md 의 실제 receipt.blockNumber 에서 확인.
# 팩토리가 releaseMyVault() 를 지원하는지. 미지원이면 배포 블록이 없을 때
# 앱이 capability probe 로 자동 판정한다.
VITE_FACTORY_RELEASE_SUPPORTED=true

# ---- Network ---------------------------------------------------------------
# 키 없는 공개 엔드포인트. 운영에서는 전용 RPC 를 권장한다.
VITE_RPC=https://worldchain-mainnet.g.alchemy.com/public

# ---- Policy ----------------------------------------------------------------
# true 면 로그인(지갑 인증) 이후에 디바이스 검증까지 요구한다.
# World App 심사 규칙상 로그인 자체를 검증으로 게이트하면 안 된다.
VITE_REQUIRE_VERIFY=false

# ---- Optional: 알림 백엔드 -------------------------------------------------
# 비워두면 알림 카드 전체가 비활성화된다.
# VITE_NOTIFY_BACKEND_URL=http://localhost:8787
# VITE_NOTIFY_BACKEND_URL=https://world-inheritance-notify.<subdomain>.workers.dev

# ---- Public origin (상속인에게 보낼 링크의 기준) --------------------------------
# World App 안에서 `window.location.origin` 은 미니앱 래퍼일 수 있다. 그러면
# "Copy link" 로 복사한 것이 래퍼를 가리켜 상속인이 앱으로 못 갈 수 있다.
# 상속 절차에서 상속인에게 닿는 **유일한 확실한 채널** 이 이 링크이므로 공개
# 주소를 여기 명시한다. 비워두면 `window.location.origin` 으로 물러난다.
VITE_APP_ORIGIN=https://inheritance.pages.dev
